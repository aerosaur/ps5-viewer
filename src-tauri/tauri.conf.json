{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PS5 Viewer",
  "version": "0.0.1",
  "identifier": "uk.aerosaur.ps5viewer",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PS5",
        "width": 1040,
        "height": 790,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
