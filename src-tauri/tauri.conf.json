{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PS5 Viewer",
  "version": "0.2.0",
  "identifier": "uk.aerosaur.ps5viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PS5",
        "width": 1040,
        "height": 790,
        "minWidth": 320,
        "minHeight": 180,
        "decorations": false,
        "resizable": true,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RTFBRDQ0RUNGOTNERUIKUldUclBmbnNSSzNoRnFSY1c4UndsMlhMcEJVaXcrVWoyN0NablVEOFJQbXdFek9aM1AyakVLWlcK",
      "endpoints": [
        "https://github.com/aerosaur/ps5-viewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
